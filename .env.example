# PolicyPilot environment variables: NAMES ONLY, never values (Document 5, Data Protection).
# Copy this file to .env (git-ignored) and fill in the values you need locally.
# Docker Compose reads .env automatically; the backend reads the same names as environment variables.

# --- Model provider (openai profile) ---------------------------------------------------------
OPENAI_API_KEY=

# --- Spring profiles ---------------------------------------------------------------------------
# openai (default) or ollama for a local model. Railway adds the cloud profile: openai,cloud
SPRING_PROFILES_ACTIVE=openai

# --- Demo protections (used from day 4 onward; leave empty until then) --------------------------
POLICYPILOT_ACCESS_CODE=
POLICYPILOT_COOKIE_SECRET=
POLICYPILOT_ADMIN_CODE=

# --- Database -----------------------------------------------------------------------------------
# Docker Compose sets its own value; Railway fills it from the database service reference.
# Both the Railway form (postgresql://user:password@host:5432/db) and the JDBC form are accepted.
DATABASE_URL=

# --- Local Ollama (ollama profile) --------------------------------------------------------------
# Docker Compose points this at its own ollama service; set it only when Ollama runs elsewhere.
OLLAMA_BASE_URL=

# --- GitHub Actions secrets (set in the repository settings, not in this file) -------------------
# NVD_API_KEY   free key from https://nvd.nist.gov/developers/request-an-api-key, speeds up
#               OWASP Dependency-Check in CI stage 4 (the stage warns and skips the scan without it)
