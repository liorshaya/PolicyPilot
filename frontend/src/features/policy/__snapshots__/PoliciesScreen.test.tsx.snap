// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PoliciesScreen in both directions (NFR-5) > LTR: an English policy reads left to right in the same screen (snapshot) 1`] = `
"
auto -           Personal Loan Policy
page -           Version 1 · 8 paragraphs · each one is a source a rule can cite
page -           Open its rules
page -           Generate rules
ltr  en          1
ltr  en          A personal loan is granted to an individual aged 21 to 65 at the time of application.
ltr  en          2
ltr  en          The loan amount is between 5,000 and 120,000 ILS and the repayment term is between 6 and 72 months.
ltr  en          3
ltr  en          The applicant must have been employed for at least 6 months with the current employer, or self-employed for at least 18 months. Applicants aged 18 and above who have been employed for at least 24 months are also eligible. Unemployed applicants are not eligible.
ltr  en          4
ltr  en          Net monthly income must be at least 7,000 ILS. For self-employed applicants the average of the last 12 months is used.
ltr  en          5
ltr  en          The monthly installment is computed with an annuity schedule at an annual interest rate of 10.8%.
ltr  en          6
ltr  en          The debt-to-income ratio, defined as existing monthly repayments plus the new installment divided by net monthly income, must not exceed 45%. Applications with a ratio between 40% and 45% are referred to an underwriter.
ltr  en          7
ltr  en          An applicant with two or more adverse credit events in the last 24 months is rejected. An applicant with exactly one event must provide a guarantor with a reasonable repayment history; without a guarantor the application is referred.
ltr  en          8
ltr  en          Applications that meet every condition above are approved. Anything not decided by the rules above is referred for manual review.
"
`;

exports[`PoliciesScreen in both directions (NFR-5) > RTL: the Hebrew policy reads right to left inside the English screen (snapshot) 1`] = `
"
auto -           מדיניות אשראי צרכני
page -           Version 1 · 9 paragraphs · each one is a source a rule can cite
page -           Open its rules
page -           Generate rules
rtl  he          1
rtl  he          הלוואה אישית תינתן ליחיד שגילו 21 עד 70 בעת הגשת הבקשה.
rtl  he          2
rtl  he          סכום ההלוואה יהיה בין 10,000 ל-150,000 ש"ח, ותקופת ההחזר בין 12 ל-84 חודשים.
rtl  he          3
rtl  he          המבקש יהיה שכיר בעל ותק של 6 חודשים לפחות במקום עבודתו הנוכחי, או עצמאי הפועל 24 חודשים לפחות, או גמלאי. מובטל אינו זכאי להלוואה.
rtl  he          4
rtl  he          המבקש יציג הכנסה יציבה. ההכנסה החודשית נטו של המבקש לא תפחת מ-8,000 ש"ח. עבור עצמאי תובא בחשבון ההכנסה הממוצעת ב-12 החודשים האחרונים.
rtl  he          5
rtl  he          ההחזר החודשי של ההלוואה יחושב לפי לוח שפיצר בריבית שנתית של 9%.
rtl  he          6
rtl  he          יחס החוב להכנסה, המחושב כסך ההחזרים החודשיים הקיימים בתוספת ההחזר החודשי של ההלוואה המבוקשת, חלקי ההכנסה החודשית נטו, לא יעלה על 40%. בקשה שיחס החוב שלה בין 35% ל-40% תועבר לבדיקת חתם.
rtl  he          7
rtl  he          מבקש שנרשמו לו שני אירועי אשראי שליליים או יותר ב-24 החודשים האחרונים, בקשתו תידחה. מבקש עם אירוע אחד יידרש להעמיד ערב.
rtl  he          8
rtl  he          גמלאים עד גיל 75 רשאים לקבל הלוואה, ובלבד שתקופת ההחזר תסתיים לפני הגיעם לגיל 78.
rtl  he          9
rtl  he          בקשה העומדת בכל התנאים לעיל תאושר. בקשה שלא הוכרעה על ידי הכללים לעיל תועבר לבדיקה ידנית.
"
`;
