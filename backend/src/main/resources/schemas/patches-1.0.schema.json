{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policypilot.dev/schemas/patches-1.0.json",
  "title": "PolicyPilot change patches 1.0 (Document 3, Change Patches; Document 4, Output Contracts)",
  "type": "object", "additionalProperties": false,
  "required": ["summary", "patches", "untouched", "notes"],
  "properties": {
    "summary": { "type": "string", "minLength": 3, "maxLength": 300 },
    "patches": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/patch" } },
    "untouched": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/ruleId" } },
    "notes": { "type": "string", "maxLength": 1000 }
  },
  "$defs": {
    "ruleId": { "type": "string", "pattern": "^R-[0-9]{2,4}$" },
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "rationale"],
      "properties": {
        "op": { "enum": ["add", "replace", "remove", "add_field", "set_defaults"] },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "rule": { "$ref": "ruleset-1.0.json#/$defs/rule" },
        "field": { "$ref": "ruleset-1.0.json#/$defs/field" },
        "defaults": { "$ref": "ruleset-1.0.json#/$defs/defaults" },
        "rationale": { "type": "string", "minLength": 3, "maxLength": 500 }
      },
      "allOf": [
        { "if": { "required": ["op"], "properties": { "op": { "const": "add" } } },
          "then": { "required": ["ruleId", "rule"], "properties": { "field": false, "defaults": false } } },
        { "if": { "required": ["op"], "properties": { "op": { "const": "replace" } } },
          "then": { "required": ["ruleId", "rule"], "properties": { "field": false, "defaults": false } } },
        { "if": { "required": ["op"], "properties": { "op": { "const": "remove" } } },
          "then": { "required": ["ruleId"], "properties": { "rule": false, "field": false, "defaults": false } } },
        { "if": { "required": ["op"], "properties": { "op": { "const": "add_field" } } },
          "then": { "required": ["field"], "properties": { "ruleId": false, "rule": false, "defaults": false } } },
        { "if": { "required": ["op"], "properties": { "op": { "const": "set_defaults" } } },
          "then": { "required": ["defaults"], "properties": { "ruleId": false, "rule": false, "field": false } } }
      ]
    }
  }
}
