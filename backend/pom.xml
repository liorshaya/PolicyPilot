<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      PolicyPilot backend (Document 2, Architecture).
      Every version below is pinned (Document 5, Supply Chain and Build Security); Spring Boot and Spring AI
      through their BOMs, everything else explicitly. Versions were checked against Maven Central on 2026-09-18.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.liorshaya</groupId>
    <artifactId>policypilot-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>PolicyPilot backend</name>
    <description>AI copilot over a deterministic rules engine: the model proposes and explains, the engine decides, a person approves.</description>

    <properties>
        <java.version>21</java.version>
        <!-- Set by -DskipITs (CI stage 2): the integration tests and the coverage check that needs them are skipped -->
        <skipITs>false</skipITs>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Spring Boot 4.0.8 manages Tomcat 11.0.24, which carries three critical CVEs fixed in 11.0.25
             (CVE-2026-65182, CVE-2026-65905, CVE-2026-68525), found by Trivy in CI stage 6 on 2026-09-18.
             Remove this override once a Spring Boot 4.0.x release manages Tomcat 11.0.25 or later. -->
        <tomcat.version>11.0.26</tomcat.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <springdoc.version>3.0.3</springdoc.version>
        <!-- springdoc 3.0.3 brings swagger-core 2.2.47 but an older swagger-annotations through a transitive
             dependency; the two must be the same version, or reading a @Schema annotation fails at runtime -->
        <swagger.version>2.2.55</swagger.version>
        <archunit.version>1.5.0</archunit.version>
        <!-- Document 6, Backend Test Design: property-based tests of the engine. -->
        <jqwik.version>1.10.1</jqwik.version>
        <!-- Document 3, JSON Schema: the networknt validator on draft 2020-12; the 3.x line runs on Jackson 3,
             the Jackson line Spring Boot 4 manages. -->
        <json-schema-validator.version>3.0.7</json-schema-validator.version>
        <!-- Document 3, Conditions: matches runs on a linear-time engine (no backtracking, no lookaround). -->
        <re2j.version>1.8</re2j.version>
        <bucket4j.version>8.20.0</bucket4j.version>
        <pdfbox.version>3.0.8</pdfbox.version>

        <jacoco.version>0.8.15</jacoco.version>
        <pitest.version>1.30.0</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <cyclonedx.version>2.9.3</cyclonedx.version>
        <jmh.version>1.37</jmh.version>
        <build-helper.version>3.6.2</build-helper.version>
        <exec-plugin.version>3.6.4</exec-plugin.version>
        <dependency-check.version>13.0.0</dependency-check.version>

        <!-- Document 6, Coverage Targets and Enforcement: PIT on engine and rules, at least 90%, a hard gate since
             day 3 (Document 7), when both packages hold their classes. -->
        <pitest.mutationThreshold>90</pitest.mutationThreshold>
        <pitest.failWhenNoMutations>true</pitest.failWhenNoMutations>

        <!-- JUnit 5 tag that excludes a flaky test from the gate while it keeps running (Document 6, CI Pipeline). -->
        <quarantine.tag>quarantine</quarantine.tag>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web layer: REST controllers and SSE endpoints (package web) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Persistence: Spring Data JPA with Flyway migrations on PostgreSQL + pgvector -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- The front door: the security filter chain, CORS and security headers (Document 2, Security and Demo
             Protections; Document 5, Authentication, Session and Authorization) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- In-memory token buckets for the rate limits of Document 5 (single instance by design) -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- Policy uploads: PDF text in memory, no scripts, no OCR (Document 5, File and path injection) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- Operations: /actuator/health is the Railway health check (Document 2, Deployment Topology) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Request tracing: a trace id on every response, in every log line and in the error envelope
             (Document 2, Observability). Brave without a reporter: ids only, nothing is exported. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>

        <!-- API documentation served at /api/docs (Document 2, API Surface) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Rules DSL: the rule set JSON Schema validator (Document 3, JSON Schema) -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.re2j</groupId>
            <artifactId>re2j</artifactId>
            <version>${re2j.version}</version>
        </dependency>

        <!-- Model providers. Both starters are on the classpath; the active profile decides which beans exist
             (Document 2, Configuration and Model Providers). Only ai.adapter may import org.springframework.ai;
             the ArchUnit suite enforces it. The pgvector vector-store starter joins on day 8 with the rag package. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>application</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Unit tests (*Test): parallel by class (src/test/resources/junit-platform.properties).
                 Quarantined tests run in a second execution that never fails the build. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    <excludedGroups>${quarantine.tag}</excludedGroups>
                    <failIfNoTests>false</failIfNoTests>
                </configuration>
                <executions>
                    <execution>
                        <id>quarantine</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>${quarantine.tag}</groups>
                            <excludedGroups/>
                            <testFailureIgnore>true</testFailureIgnore>
                            <reportsDirectory>${project.build.directory}/surefire-reports-quarantine</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Integration tests (*IT) against Testcontainers PostgreSQL with pgvector (Document 6, Test Levels). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{failsafeArgLine} -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    <excludedGroups>${quarantine.tag}</excludedGroups>
                    <failIfNoTests>false</failIfNoTests>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>quarantine-it</id>
                        <goals>
                            <goal>integration-test</goal>
                        </goals>
                        <configuration>
                            <groups>${quarantine.tag}</groups>
                            <excludedGroups/>
                            <testFailureIgnore>true</testFailureIgnore>
                            <reportsDirectory>${project.build.directory}/failsafe-reports-quarantine</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage gates per package (Document 6, Coverage Targets and Enforcement).
                 Unit and integration runs append to one execution file, so ./mvnw verify checks the merged coverage. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-unit-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>prepare-integration-agent</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                            <propertyName>failsafeArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Packages measured on unit tests alone (Document 6, Gates in CI): checked in stage 2 and in every verify -->
                    <execution>
                        <id>check-unit</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Decides cases: 100% line and branch, mutation tested -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.liorshaya.policypilot.engine</include>
                                        <include>com.liorshaya.policypilot.engine.*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.liorshaya.policypilot.rules</include>
                                        <include>com.liorshaya.policypilot.rules.*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- Protects: 95% line, 90% branch -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.liorshaya.policypilot.web.security</include>
                                        <include>com.liorshaya.policypilot.web.security.*</include>
                                        <include>com.liorshaya.policypilot.web.validation</include>
                                        <include>com.liorshaya.policypilot.web.validation.*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- ai use cases, validation loop, marker resolver: 90% line, 85% branch (adapter excluded) -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.liorshaya.policypilot.ai</include>
                                        <include>com.liorshaya.policypilot.ai.*</include>
                                    </includes>
                                    <excludes>
                                        <exclude>com.liorshaya.policypilot.ai.adapter</exclude>
                                        <exclude>com.liorshaya.policypilot.ai.adapter.*</exclude>
                                    </excludes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- common: shared helpers are reused everywhere; not in Document 6, held to the ai level -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.liorshaya.policypilot.common</include>
                                        <include>com.liorshaya.policypilot.common.*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <!-- Packages measured on unit and integration tests together: checked by a full verify (stage 5), skipped with -DskipITs -->
                    <execution>
                        <id>check-merged</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${skipITs}</skip>
                            <rules>
                                <!-- rag: 85% line, 80% branch -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.liorshaya.policypilot.rag</include>
                                        <include>com.liorshaya.policypilot.rag.*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- Orchestrates: 80% line, 75% branch -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.liorshaya.policypilot.policy</include>
                                        <include>com.liorshaya.policypilot.policy.*</include>
                                        <include>com.liorshaya.policypilot.ruleset</include>
                                        <include>com.liorshaya.policypilot.ruleset.*</include>
                                        <include>com.liorshaya.policypilot.decision</include>
                                        <include>com.liorshaya.policypilot.decision.*</include>
                                        <include>com.liorshaya.policypilot.change</include>
                                        <include>com.liorshaya.policypilot.change.*</include>
                                        <include>com.liorshaya.policypilot.audit</include>
                                        <include>com.liorshaya.policypilot.audit.*</include>
                                        <include>com.liorshaya.policypilot.demo</include>
                                        <include>com.liorshaya.policypilot.demo.*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- Adapts: ai.adapter, controllers and DTOs, configuration classes: 70% line, 60% branch -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.liorshaya.policypilot.ai.adapter</include>
                                        <include>com.liorshaya.policypilot.ai.adapter.*</include>
                                        <include>com.liorshaya.policypilot.web</include>
                                        <include>com.liorshaya.policypilot.web.*</include>
                                        <include>com.liorshaya.policypilot.config</include>
                                        <include>com.liorshaya.policypilot.config.*</include>
                                    </includes>
                                    <excludes>
                                        <exclude>com.liorshaya.policypilot.web.security</exclude>
                                        <exclude>com.liorshaya.policypilot.web.security.*</exclude>
                                        <exclude>com.liorshaya.policypilot.web.validation</exclude>
                                        <exclude>com.liorshaya.policypilot.web.validation.*</exclude>
                                    </excludes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.70</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.60</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- CI stage 3: ./mvnw -Pmutation test-compile pitest:mutationCoverage -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>com.liorshaya.policypilot.engine.*</param>
                                <param>com.liorshaya.policypilot.rules.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.liorshaya.policypilot.engine.*</param>
                                <param>com.liorshaya.policypilot.rules.*</param>
                            </targetTests>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                                <mutator>CONDITIONALS_BOUNDARY</mutator>
                                <mutator>NEGATE_CONDITIONALS</mutator>
                            </mutators>
                            <mutationThreshold>${pitest.mutationThreshold}</mutationThreshold>
                            <failWhenNoMutations>${pitest.failWhenNoMutations}</failWhenNoMutations>
                            <excludedGroups>
                                <param>${quarantine.tag}</param>
                            </excludedGroups>
                            <outputFormats>
                                <param>XML</param>
                                <param>HTML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <threads>2</threads>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- CI stage 4: ./mvnw -Psupply-chain -DskipTests dependency-check:check (needs NVD_API_KEY, see .env.example) -->
        <profile>
            <id>supply-chain</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.version}</version>
                        <configuration>
                            <!-- CVSS 7.0 and above is High; a finding fails the build unless it is listed, with a reason,
                                 in dependency-check-suppressions.xml (Document 5: "without a documented exception") -->
                            <failBuildOnCVSS>7.0</failBuildOnCVSS>
                            <suppressionFiles>
                                <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <nugetconfAnalyzerEnabled>false</nugetconfAnalyzerEnabled>
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Document 6, Performance and Determinism: the engine micro-benchmark, reported, not a gate.
             ./mvnw -Pbenchmark -DskipTests test-compile exec:exec -->
        <profile>
            <id>benchmark</id>
            <dependencies>
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-core</artifactId>
                    <version>${jmh.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-generator-annprocess</artifactId>
                    <version>${jmh.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${build-helper.version}</version>
                        <executions>
                            <execution>
                                <id>benchmark-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/jmh/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- JMH generates its harness with an annotation processor, named here because newer JDKs no
                             longer run processors found on the class path. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-testCompile</id>
                                <configuration>
                                    <annotationProcessorPaths>
                                        <path>
                                            <groupId>org.openjdk.jmh</groupId>
                                            <artifactId>jmh-generator-annprocess</artifactId>
                                            <version>${jmh.version}</version>
                                        </path>
                                    </annotationProcessorPaths>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-plugin.version}</version>
                        <configuration>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>org.openjdk.jmh.Main</argument>
                                <argument>EngineBenchmark</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

