{
  "id": "C-22",
  "name": "matches",
  "spec": "Document 3, Conformance Suite",
  "ruleset": {
    "dslVersion": "1.0",
    "id": "c22",
    "name": "conformance c22",
    "language": "en",
    "fields": [
      {
        "name": "s",
        "type": "string",
        "required": true
      }
    ],
    "defaults": {
