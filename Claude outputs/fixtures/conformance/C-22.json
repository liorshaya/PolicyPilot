          {
            "type": "decide",
            "outcome": "reject",
            "terminal": true,
            "reason": "reject by fixture rule"
          }
        ],
        "provenance": {
          "kind": "analyst",
          "note": "conformance fixture, written by hand from Document 3",
          "actor": "spec"
        }
      },
      {
        "id": "R-900",
        "label": "conformance rule R-900",
        "priority": 900,
        "condition": {
          "always": true
        },
        "actions": [
          {
            "type": "decide",
            "outcome": "approve",
            "terminal": true,
            "reason": "approve by fixture rule"
          }
        ],
        "provenance": {
          "kind": "analyst",
          "note": "conformance fixture, written by hand from Document 3",
          "actor": "spec"
        }
      }
    ]
  },
  "checks": [
    {
      "case": {
        "s": "IL12"
      },
      "expected": {
        "status": "OK",
        "outcome": "reject",
        "decidingRuleId": "R-100"
      }
    },
    {
      "case": {
        "s": "XX12"
      },
      "expected": {
        "status": "OK",
        "outcome": "approve",
        "decidingRuleId": "R-900",
        "trace": [
          {
            "ruleId": "R-100",
            "status": "not_fired"
          },
          {
            "ruleId": "R-900",
            "status": "fired"
          }
        ]
