      },
      "actions": [
        {
          "type": "decide",
          "outcome": "reject",
          "terminal": true,
          "reason": "Graduate students are not covered by this policy"
        }
      ],
      "provenance": {
        "kind": "quoted",
        "paragraph": 6,
