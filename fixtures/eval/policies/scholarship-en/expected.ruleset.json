  "rules": [
    {
      "id": "R-010",
      "label": "Excellence scholarship of 6,000",
      "priority": 10,
      "condition": {
        "field": "gpa",
        "op": "gte",
        "value": 88
      },
      "actions": [
        {
          "type": "set",
          "field": "scholarship_amount",
          "value": 6000
        }
      ],
      "provenance": {
        "kind": "quoted",
        "paragraph": 1,
        "quote": "are eligible for an excellence scholarship of 6,000 ILS",
        "confidence": 0.95
      },
      "tags": [
        "derivation"
      ]
    },
    {
      "id": "R-020",
      "label": "Need supplement of 3,000",
      "priority": 20,
      "condition": {
        "all": [
          {
            "field": "gpa",
            "op": "gte",
            "value": 88
          },
          {
            "field": "income_per_person",
            "op": "lt",
            "value": 3500
          }
        ]
      },
      "actions": [
        {
          "type": "set",
          "field": "scholarship_amount",
          "value": {
            "fn": "add",
            "args": [
              {
                "field": "scholarship_amount"
              },
              3000
            ]
          }
        }
      ],
      "provenance": {
        "kind": "quoted",
        "paragraph": 3,
        "quote": "Students whose household income per person is below 3,500 ILS per month receive an additional need supplement of 3,000 ILS",
        "confidence": 0.95
      },
      "tags": [
        "derivation"
      ]
    },
    {
